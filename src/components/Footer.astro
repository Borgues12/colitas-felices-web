---
import { Image } from "astro:assets";
import fondo from "../assets/images/footer/footer-pets.webp";

const year = new Date().getFullYear();
const WA = "593983750246";

const enlaces = [
  { href: "/#inicio", label: "Inicio" },
  { href: "/#historia", label: "Historia" },
  { href: "/#galeria", label: "Galería" },
  { href: "/#ubicacion", label: "Cómo llegar" },
  { href: "/#ayudar", label: "Cómo ayudar" },
];

const redes = [
  {
    href: "https://www.facebook.com/colitasfelicesecuador",
    icon: "bi-facebook",
    label: "Facebook",
  },
  {
    href: "https://www.instagram.com/colitasfelicesecuador",
    icon: "bi-instagram",
    label: "Instagram",
  },
  {
    href: "https://www.tiktok.com/@colitasfelicesdiana",
    icon: "bi-tiktok",
    label: "TikTok",
  },
];
---

<footer class="cf-footer">
  <Image
    class="cf-footer-bg"
    src={fondo}
    alt=""
    widths={[768, 1280, 1920]}
    sizes="100vw"
    format="webp"
    loading="lazy"
    aria-hidden="true"
  />

  <div class="cf-footer-body">
    <div class="container">
      <div class="columns is-variable is-6">
        <div class="column is-5">
          <div class="cf-footer-logo">
            <img src="/img/logo/logo_mini.svg" alt="Logo Colitas Felices" />
            <span class="cf-footer-brand">Colitas Felices</span>
          </div>
          <p>
            Rescatamos, cuidamos y buscamos hogar para perros y gatos en
            situación de abandono.
          </p>
          <div class="cf-footer-social">
            {
              redes.map((r) => (
                <a
                  href={r.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={r.label}
                >
                  <i class={`bi ${r.icon}`} />
                </a>
              ))
            }
          </div>
        </div>

        <div class="column is-3">
          <p class="cf-footer-title">Enlaces</p>
          <ul>
            {
              enlaces.map((e) => (
                <li>
                  <a href={e.href}>{e.label}</a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="column is-4">
          <p class="cf-footer-title">Contacto</p>
          <ul>
            <li>
              <i class="bi bi-envelope"></i>
              <a href="mailto:candongadiana6@gmail.com"
                >candongadiana6@gmail.com</a
              >
            </li>
            <li>
              <i class="bi bi-whatsapp"></i>
              <a href={`https://wa.me/${WA}`} target="_blank" rel="noopener"
                >098 375 0246</a
              >
            </li>
          </ul>
        </div>
      </div>

      <p class="cf-footer-copy">
        © {year} Fundación Colitas Felices. Todos los derechos reservados.
      </p>
      <p class="cf-credit">
        Desarrollado por <a
          href="https://www.linkedin.com/in/jose-gallardo-40552623a/"
          target="_blank"
          rel="noopener noreferrer">Jose Gallardo</a
        >
      </p>
    </div>
  </div>
</footer>

<style>
  .cf-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--cf-logo-dark);
  }

  .cf-footer :global(.cf-footer-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    z-index: -2;
  }

  .cf-footer::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      rgba(65, 24, 32, 0.85),
      rgba(65, 24, 32, 0.65)
    );
  }

  .cf-footer-body {
    padding: 3rem 1.5rem 1.5rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .cf-footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .cf-footer-logo img {
    max-height: 3.5rem;
  }

  .cf-footer-brand {
    font-family: var(--cf-font-brand);
    font-size: 1.75rem;
    color: #fff;
  }

  .cf-footer-title {
    margin-bottom: 1rem;
    font-family: var(--cf-font-heading);
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cf-accent-2);
  }

  .cf-footer-body ul li {
    margin-bottom: 0.5rem;
  }
  .cf-footer-body ul li i {
    margin-right: 0.5rem;
    color: var(--cf-accent-2);
  }

  .cf-footer-body a {
    color: rgba(255, 255, 255, 0.8);
    transition: color 0.2s ease;
  }
  .cf-footer-body a:hover {
    color: var(--cf-accent-2);
  }

  .cf-footer-social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .cf-footer-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 1.15rem;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }
  .cf-footer-social a:hover {
    background: var(--cf-brand);
    color: #fff;
    transform: translateY(-3px);
  }

  .cf-footer-copy {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    text-align: center;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .cf-footer-body a,
    .cf-footer-social a {
      transition: none;
    }
    .cf-footer-social a:hover {
      transform: none;
    }
  }

  .cf-credit {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    text-align: center;
    color: #ffffff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .cf-credit a {
    color: #ffffff;
    font-weight: 700;
    text-decoration-color: var(--cf-accent-2);
    text-underline-offset: 0.25em;
    text-decoration-thickness: 2px;
  }

  .cf-credit a:hover {
    color: var(--cf-accent-2);
    text-decoration-color: var(--cf-brand);
  }
</style>
