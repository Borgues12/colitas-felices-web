---
import { Image } from "astro:assets";
import diana from "../assets/images/historia/diana.webp";
import wilmer from "../assets/images/historia/wilmer.webp";
import yordy from "../assets/images/historia/yordy.webp";
import cristian from "../assets/images/historia/cristian.webp";
import juanCarlos from "../assets/images/historia/juan-carlos.webp";

const fundadora = {
  img: diana,
  alt: "Diana Candonga, fundadora",
  role: "Fundadora",
  name: "Diana Candonga",
  subtitle: "Fundación Colitas Felices & Rescate de Angelitos",
  bio: [
    "Diana es una rescatista que convirtió su amor por los animales en una misión de vida. Desde 2015 dedica sus esfuerzos al rescate, la recuperación y la protección de animales en situación de abandono y maltrato.",
    "A través de la fundación trabaja incansablemente para brindarles una segunda oportunidad, un hogar digno y la posibilidad de conocer el amor. Su mayor sueño es construir un mundo más compasivo, donde ningún animal sea olvidado y cada vida sea tratada con respeto y dignidad.",
  ],
  quote: "Rescatar una vida es devolverle la oportunidad de ser feliz.",
};

const equipo = [
  {
    img: wilmer,
    alt: "Wilmer Sifontes, rescatista",
    role: "Rescatista",
    name: "Wilmer Sifontes",
    bio: [
      "Parte de la familia desde 2021. Con su fuerza y dedicación fue fundamental para levantar el refugio. Cada día cuida, cura y supervisa a nuestros perritos, y acude al llamado de emergencia cuando un animal necesita ayuda, incluso cruzando fronteras.",
      "Rescatar no es solo salvar vidas, es estar presentes cuando más nos necesitan.",
    ],
  },
  {
    img: yordy,
    alt: "Yordy López, cuidador",
    role: "Cuidador",
    name: "Yordy López",
    bio: [
      "Comparte su día y su noche con nuestros perritos, permaneciendo junto a ellos las 24 horas. Se encarga de alimentarlos, limpiar sus espacios y estar atento a su bienestar para que vivan seguros, limpios y rodeados de cuidados.",
    ],
  },
  {
    img: cristian,
    alt: "Cristian Cueva, cuidador",
    role: "Cuidador",
    name: "Cristian Cueva",
    bio: [
      "Minucioso, paciente y responsable. Mantiene los espacios limpios, les da su alimentación adecuada y está pendiente de cada uno. Trabaja con respeto, sin gritos ni maltratos, brindándoles tranquilidad y seguridad.",
    ],
  },
  {
    img: juanCarlos,
    alt: "Juan Carlos Mendoza, nuevo integrante",
    role: "Nuevo integrante",
    name: "Juan Carlos Mendoza",
    bio: [
      "Se incorporó recientemente al equipo. Motivado por su cariño hacia los animales, aprende cada día con entusiasmo y compromiso, siempre dispuesto a trabajar en equipo. Su camino en el refugio apenas comienza.",
    ],
  },
];
---

<section id="historia" class="section cf-history">
  <div class="container">
    <div class="columns is-centered mb-6 cf-reveal">
      <div class="column is-10-tablet is-8-desktop has-text-centered">
        <h2 class="title is-2 cf-title-xl">
          Todo empezó con una
          <mark class="cf-highlight"><span class="font-accent cf-script">colita</span></mark>.
          Esta es nuestra historia, contada por quienes la empezaron.
        </h2>
      </div>
    </div>

    <article class="cf-team-card is-featured cf-reveal">
      <figure class="cf-team-photo">
        <Image
          src={fundadora.img}
          alt={fundadora.alt}
          widths={[400, 640]}
          sizes="(max-width: 768px) 100vw, 34vw"
          format="webp"
          loading="lazy"
        />
        <span class="cf-team-role">{fundadora.role}</span>
      </figure>
      <div class="cf-team-body">
        <h3 class="cf-team-name">{fundadora.name}</h3>
        <p class="cf-team-subtitle">{fundadora.subtitle}</p>
        {fundadora.bio.map((p) => <p class="cf-team-bio">{p}</p>)}
        <blockquote class="cf-team-quote">{fundadora.quote}</blockquote>
      </div>
    </article>

    <div class="cf-team-grid">
      {equipo.map((m, i) => (
        <article class="cf-team-card cf-reveal" style={`--d:${(i % 2) * 100}ms`}>
          <figure class="cf-team-photo">
            <Image
              src={m.img}
              alt={m.alt}
              widths={[320, 480]}
              sizes="(max-width: 768px) 100vw, 20vw"
              format="webp"
              loading="lazy"
            />
            <span class="cf-team-role">{m.role}</span>
          </figure>
          <div class="cf-team-body">
            <h3 class="cf-team-name">{m.name}</h3>
            {m.bio.map((p) => <p class="cf-team-bio">{p}</p>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cf-history {
    background-color: var(--cf-accent-3);
  }

  .cf-team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    margin-top: 2rem;
  }
  @media (min-width: 1024px) {
    .cf-team-grid { grid-template-columns: 1fr 1fr; }
  }

  .cf-team-card {
    display: flex;
    background: var(--cf-surface);
    border: 1px solid var(--cf-border);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .cf-team-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(233, 30, 99, 0.12);
  }

  .cf-team-photo {
    position: relative;
    flex: 0 0 38%;
    margin: 0;
    background: var(--cf-accent-4);
    overflow: hidden;
  }
  .cf-team-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .cf-team-card:hover .cf-team-photo :global(img) {
    transform: scale(1.05);
  }

  .cf-team-role {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.7rem;
    background: var(--cf-accent-1);
    color: var(--cf-brand);
    border: 1px solid var(--cf-accent-2);
    border-radius: 4px;
    font-family: var(--cf-font-heading);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cf-team-body {
    flex: 1;
    padding: 1.5rem;
  }

  .cf-team-name {
    margin-bottom: 0.25rem;
    font-family: var(--cf-font-heading);
    font-size: 1.25rem;
    color: var(--cf-text-strong);
  }

  .cf-team-subtitle {
    margin-bottom: 1rem;
    font-size: 0.85rem;
    color: var(--cf-brand);
  }

  .cf-team-bio {
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--cf-text);
  }

  .cf-team-quote {
    margin: 1rem 0 0;
    padding-left: 1rem;
    border-left: 3px solid var(--cf-brand);
    font-family: var(--cf-font-accent);
    font-size: 1.3rem;
    color: var(--cf-text-strong);
  }

  /* Tarjeta destacada */
  .is-featured .cf-team-photo { flex-basis: 34%; }
  .is-featured .cf-team-photo :global(img) { min-height: 380px; }
  .is-featured .cf-team-body { padding: 2.5rem; }
  .is-featured .cf-team-name { font-size: 1.9rem; }

  @media (max-width: 768px) {
    .cf-team-card { flex-direction: column; }
    .cf-team-photo,
    .is-featured .cf-team-photo { flex-basis: auto; }
    .cf-team-photo :global(img),
    .is-featured .cf-team-photo :global(img) {
      min-height: 0;
      height: 280px;
    }
    .is-featured .cf-team-body { padding: 1.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cf-team-card,
    .cf-team-photo :global(img) { transition: none; }
    .cf-team-card:hover,
    .cf-team-card:hover .cf-team-photo :global(img) { transform: none; }
  }
</style>