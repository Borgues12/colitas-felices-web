---
const links = [
  { href: "/#inicio", label: "Inicio" },
  { href: "/#nosotros", label: "Nosotros" },
  { href: "/#historia", label: "Historia" },
  { href: "/#galeria", label: "Galería" },
  { href: "/#ubicacion", label: "Cómo llegar" },
];
---

<nav
  class="navbar cf-nav is-fixed-top"
  role="navigation"
  aria-label="main navigation"
>
  <div class="container">
    <div class="navbar-brand">
      <a class="navbar-item has-text-weight-bold" href="/">
        <img
          src="/img/logo/logo.svg"
          alt="Logo Colitas Felices"
          class="mr-2"
          style="max-height: 3.5rem;"
        />
      </a>
      <a
        role="button"
        class="navbar-burger"
        aria-label="menu"
        aria-expanded="false"
        data-target="mainMenu"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </a>
    </div>
    <div id="mainMenu" class="navbar-menu">
      <div class="navbar-start is-hidden-touch">
        <div class="navbar-item">
          <span class="cf-status">
            <span class="cf-status-dot" aria-hidden="true"></span>
            Adopciones abiertas
          </span>
        </div>
      </div>
      <div class="navbar-end">
        {
          links.map((l) => (
            <a class="navbar-item cf-link" href={l.href}>
              {l.label}
            </a>
          ))
        }
        <div class="navbar-item">
          <a class="button is-primary cf-nav-cta" href="/#ayudar">Cómo ayudar</a
          >
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const burger = document.querySelector<HTMLElement>(".navbar-burger");
  const menu = document.getElementById("mainMenu");
  const nav = document.querySelector(".cf-nav");

  function setMenu(open: boolean) {
    burger?.classList.toggle("is-active", open);
    menu?.classList.toggle("is-active", open);
    burger?.setAttribute("aria-expanded", String(open));
  }

  burger?.addEventListener("click", () => {
    setMenu(!burger.classList.contains("is-active"));
  });

  menu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => setMenu(false));
  });

  const onScroll = () =>
    nav?.classList.toggle("is-scrolled", window.scrollY > 10);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
  .cf-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--cf-font-heading);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cf-brand);
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: var(--cf-accent-1);
    border: 1px solid var(--cf-accent-2);
  }

  .cf-status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--cf-brand);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cf-status-dot {
      animation: cf-pulse 2s ease-in-out infinite;
    }
  }

  @keyframes cf-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(233, 30, 99, 0.45);
    }
    50% {
      box-shadow: 0 0 0 0.35rem rgba(233, 30, 99, 0);
    }
  }
</style>
