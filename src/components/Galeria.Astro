---
import { getImage } from "astro:assets";

const categorias = [
  {
    id: "perritos",
    titulo: "Perritos",
    frase: "Cada uno llegó con una historia difícil y hoy recibe cuidado, comida y cariño.",
    alt: "Perro rescatado por la fundación Colitas Felices",
    fotos: [
      "perros1", "perros2", "foto1", "foto2", "foto3", "foto4", "foto5", "foto6",
      "foto7", "foto8", "foto9", "foto10", "foto11", "foto13", "foto14",
    ],
  },
  {
    id: "gatos",
    titulo: "Gatitos",
    frase: "Pequeños sobrevivientes que aprenden a confiar y a ronronear de nuevo.",
    alt: "Gato rescatado por la fundación Colitas Felices",
    fotos: ["gato1", "gato2", "gato3"],
  },
  {
    id: "granja",
    titulo: "Nuestra granja",
    frase: "Un espacio de paz donde también viven animales que encontraron un segundo hogar.",
    alt: "Animal de la granja de la fundación Colitas Felices",
    fotos: ["granja1", "granja2", "granja3", "granja4", "granja5"],
  },
];

const imagenes = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/images/galeria/*.{webp,jpg,jpeg,png}",
  { eager: true }
);

const bloques = await Promise.all(
  categorias.map(async (cat) => {
    const urls = await Promise.all(
      cat.fotos.map(async (nombre) => {
        const meta = Object.entries(imagenes).find(([ruta]) =>
          ruta.includes(`/galeria/${nombre}.`)
        )?.[1].default;
        if (!meta) {
          console.warn(`Galería: no se encontró la imagen "${nombre}"`);
          return null;
        }
        const img = await getImage({ src: meta, width: 800, height: 600, format: "webp" });
        return img.src;
      })
    );
    return { ...cat, urls: urls.filter((u): u is string => u !== null) };
  })
);
---

<section id="galeria" class="section cf-gallery">
  <div class="container">
    {bloques.map((cat, c) => (
      <div
        class:list={["cf-gallery-block", "cf-reveal", { "is-reverse": c % 2 === 1 }]}
        id={`galeria-${cat.id}`}
      >
        <div class="cf-gallery-head">
          <h3 class="cf-gallery-title">{cat.titulo}</h3>
          <span class="cf-gallery-line" aria-hidden="true"></span>
          <p class="cf-gallery-phrase">{cat.frase}</p>
        </div>

        <div
          class:list={["cf-bento", { "is-3": cat.urls.length < 4 }]}
          data-bento
          data-fotos={JSON.stringify(cat.urls)}
        >
          {cat.urls.slice(0, 4).map((src, s) => (
            <div class={`cf-bento-tile cf-bento-${s + 1}`}>
              <img src={src} alt={cat.alt} width="800" height="600" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const INTERVAL = 3500;
  const FADE = 500;

  document.querySelectorAll<HTMLElement>("[data-bento]").forEach((bento, idx) => {
    const pool: string[] = JSON.parse(bento.dataset.fotos ?? "[]");
    const tiles = Array.from(bento.querySelectorAll<HTMLImageElement>(".cf-bento-tile img"));
    if (reduce || pool.length <= tiles.length) return;

    let next = tiles.length;
    let turn = 0;
    let visible = false;

    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
    }).observe(bento);

    function swap() {
      if (!visible || document.hidden) return;
      const img = tiles[turn % tiles.length];
      const src = pool[next % pool.length];
      turn++;
      next++;

      const pre = new Image();
      pre.onload = () => {
        img.classList.add("is-fading");
        setTimeout(() => {
          img.src = src;
          img.classList.remove("is-fading");
        }, FADE);
      };
      pre.src = src;
    }

    setTimeout(() => setInterval(swap, INTERVAL), idx * 1200);
  });
</script>

<style>
  .cf-gallery {
    background-color: var(--cf-surface);
  }

  .cf-gallery-block {
    display: grid;
    grid-template-columns: minmax(240px, 1fr) 2.4fr;
    gap: 3.5rem;
    align-items: center;
  }

  .cf-gallery-block.is-reverse {
    grid-template-columns: 2.4fr minmax(240px, 1fr);
  }
  .cf-gallery-block.is-reverse .cf-gallery-head {
    order: 2;
    text-align: right;
  }

  .cf-gallery-block + .cf-gallery-block {
    margin-top: 7rem;
    padding-top: 6rem;
    border-top: 1px dashed rgba(0, 0, 0, 0.2);
  }

  .cf-gallery-title {
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .cf-gallery-line {
    display: block;
    width: 64px;
    height: 4px;
    border-radius: 2px;
    background: var(--cf-brand);
    margin: 1.25rem 0;
  }
  .cf-gallery-block.is-reverse .cf-gallery-line { margin-left: auto; }

  .cf-gallery-phrase {
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.6;
    opacity: 0.8;
    margin: 0;
  }

  /* Mosaico */
  .cf-bento {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 0.75rem;
    height: 460px;
  }

  .cf-bento-tile {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: var(--cf-accent-4);
  }

  .cf-bento-tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity 0.5s ease;
  }
  .cf-bento-tile img.is-fading { opacity: 0; }

  .cf-bento-1 { grid-column: 1; grid-row: 1 / span 2; }
  .cf-bento-2 { grid-column: 2; grid-row: 1; }
  .cf-bento-3 { grid-column: 3; grid-row: 1; }
  .cf-bento-4 { grid-column: 2 / span 2; grid-row: 2; }

  .cf-bento.is-3 .cf-bento-2,
  .cf-bento.is-3 .cf-bento-3 { grid-row: 1 / span 2; }

  @media (max-width: 768px) {
    .cf-gallery-block,
    .cf-gallery-block.is-reverse {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .cf-gallery-block.is-reverse .cf-gallery-head { order: 0; }
    .cf-gallery-head,
    .cf-gallery-block.is-reverse .cf-gallery-head { text-align: center; }
    .cf-gallery-line,
    .cf-gallery-block.is-reverse .cf-gallery-line { margin-left: auto; margin-right: auto; }
    .cf-gallery-block + .cf-gallery-block { margin-top: 4rem; padding-top: 4rem; }

    .cf-bento {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 180px 180px 180px;
      height: auto;
    }
    .cf-bento-1 { grid-column: 1 / span 2; grid-row: 1; }
    .cf-bento-2 { grid-column: 1; grid-row: 2; }
    .cf-bento-3 { grid-column: 2; grid-row: 2; }
    .cf-bento-4 { grid-column: 1 / span 2; grid-row: 3; }

    .cf-bento.is-3 { grid-template-rows: 180px 180px; }
    .cf-bento.is-3 .cf-bento-2,
    .cf-bento.is-3 .cf-bento-3 { grid-row: 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cf-bento-tile img { transition: none; }
  }
</style>